{
  "connector.class": "io.aiven.kafka.connect.s3.AivenKafkaConnectS3SinkConnector",
  "tasks.max": "1",
  "topics": "business.public.customers,business.public.products,business.public.orders,business.public.order_items,business.public.marketing_spend,business.public.sessions,business.public.returns,business.public.inventory",

  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",

  "format.output.type": "jsonl",
  "format.output.fields": "value",
  "file.compression.type": "none",
  "file.name.template": "{{topic}}/dt={{timestamp:unit=yyyy}}-{{timestamp:unit=MM}}-{{timestamp:unit=dd}}/{{partition:padding=true}}-{{start_offset:padding=true}}.jsonl",
  "timestamp.source": "event",
  "file.name.timestamp.timezone": "UTC",

  "aws.s3.bucket.name": "cdc-events",
  "aws.s3.endpoint": "http://minio:9000",
  "aws.s3.region": "us-east-1",
  "aws.access.key.id": "minioadmin",
  "aws.secret.access.key": "minioadmin"
}
